# Supabase (production data layer)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Map basemap style (MapLibre style JSON URL)
VITE_MAP_STYLE_DARK=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
VITE_MAP_STYLE_LIGHT=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json

# Payment provider (server-side keys must never live in the frontend)
VITE_PAYMENT_PROVIDER=mock

# Messaging providers
VITE_SMS_PROVIDER=mock
VITE_WHATSAPP_PROVIDER=mock

# Telemetry / GPS provider
VITE_GPS_PROVIDER=simulator

# Environment flags
VITE_ENABLE_ROLE_SWITCHER=true
VITE_ENABLE_TRIP_SIMULATOR=true
